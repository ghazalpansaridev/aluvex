# ============================================
# Client App Configuration (Expo/React Native)
# ============================================
# These variables are used by the Expo app and are loaded via app.config.js
# Variables with EXPO_PUBLIC_ prefix are automatically exposed to the client

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_PROJECT_ID=your_eas_project_id_here

# ============================================
# Supabase Edge Functions Configuration
# ============================================
# These variables are used by Supabase Edge Functions (Deno runtime)
# They are NOT loaded from this file - they must be set via:
# 
# For Production:
#   - Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# For Local Development:
#   - Use: supabase secrets set TWILIO_ACCOUNT_SID=your_value
#   - Or create a .env file in the supabase/ directory (if using Supabase CLI)
#
# Required for send-otp function:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
#
# Required for all Edge Functions:
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key